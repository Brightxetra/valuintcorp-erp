NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
NEXT_PUBLIC_MARKETING_SITE_URL=https://valuintcorp.vercel.app
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ERP_ATTACHMENTS_BUCKET=erp-attachments
CRON_SECRET=

# Local/E2E only. Missing Supabase configuration never enables demo automatically,
# and production verification rejects this value when set to "true".
NEXT_PUBLIC_DEMO_MODE=true

# Optional deployment label for operations. Production builds/starts fail closed; trusted
# Vercel preview/development runtimes are identified by VERCEL=1 plus VERCEL_ENV.
VALUINTCORP_DEPLOYMENT_ENV=development

# Optional: set to "true" in production/pilot when Supabase demo accounts should auto-bootstrap sandbox tenants.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false

# Seed-only secret. Required explicitly by npm run seed:demo-accounts and never logged.
DEMO_ACCOUNT_PASSWORD=
DEMO_ACCOUNT_TEMPLATE_ID=food_beverage
